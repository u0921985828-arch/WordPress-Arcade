# Latencia: WordPress añade ?ver=<versión del plugin> al CSS y al JS del portal, así que se pueden guardar
# para siempre; los iconos y el logo no llevan versión, una semana.
# Si el servidor no tiene mod_headers, estas reglas se ignoran sin dar error.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(svg|png|webp|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Comprimir texto (brotli si está, si no gzip): JS, CSS, HTML, JSON y SVG bajan a ~1/4.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/css text/html text/plain text/javascript application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/css text/html text/plain text/javascript application/javascript application/json image/svg+xml
</IfModule>
